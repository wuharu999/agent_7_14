APP_NAME=Uchat Knowledge Base
PUBLIC_BASE_URL=http://120.77.250.227:8000
# Optional path prefix used by a reverse proxy or WAF. Leave empty for root deployments.
ROOT_PATH=
DATA_ROOT=/root/agent_7_14/ecs-data
DATABASE_PATH=/root/agent_7_14/ecs-data/agent_jobs.db
ALLOWED_TEAMS=tian_gong,walker_s2,walker_c1
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
WORKER_TIMEOUT=240
FILE_COMMAND_TIMEOUT=60

# Browser login/session settings.
SESSION_COOKIE_NAME=agent1_session
SESSION_HOURS=8
# false for current HTTP testing; change to true after HTTPS is enabled.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional sibling browser_parse application (shared host and login cookie).
BROWSER_TOOLS_URL=
# Override before the first startup of a fresh database.
DEFAULT_ADMIN_PASSWORD=Admin#2026!Secured89

# Chinese template alerts + weekly digest, sent by the ECS gateway.
# Use a dedicated QQ mailbox; SMTP password is its authorization code, NOT login password.
# Keep false until mailbox, authorization code and real admin recipient addresses are ready.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURITY=ssl
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=机器人知识平台
# Monday 09:00 Asia/Shanghai, covering the preceding full calendar week.
EMAIL_WEEKLY_ENABLED=true
