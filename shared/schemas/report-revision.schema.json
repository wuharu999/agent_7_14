{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/report-revision.schema.json",
  "title": "Immutable Scenario Report Revision",
  "type": "object",
  "required": ["report_revision_id", "session_id", "ordinal", "scenario_state_version", "status", "conclusion", "conditions", "main_evidence", "high_impact_unknowns", "next_actions", "technical_details", "metadata"],
  "properties": {
    "report_revision_id": {"type": "string", "pattern": "^REPORT-[A-Z0-9]+$"},
    "session_id": {"type": "string", "pattern": "^SCNSESSION-[A-Z0-9]+$"},
    "ordinal": {"type": "integer", "minimum": 1},
    "scenario_state_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["current", "superseded", "failed", "processing", "partial"]},
    "conclusion": {"enum": ["fit", "fit_with_conditions", "prototype_required", "insufficient_evidence", "not_a_fit"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "main_evidence": {"type": "array", "items": {"type": "object"}},
    "high_impact_unknowns": {"type": "array", "items": {"type": "object"}},
    "next_actions": {"type": "array", "items": {"type": "object"}},
    "technical_details": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
