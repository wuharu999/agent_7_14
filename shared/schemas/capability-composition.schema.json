{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/capability-composition.schema.json",
  "title": "Robot Capability Composition",
  "type": "object",
  "required": [
    "composition_id",
    "name",
    "requirement_ids",
    "effect",
    "nodes",
    "edges",
    "preconditions",
    "hold_conditions",
    "postconditions",
    "resources",
    "failure_policy",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "composition_id": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 3},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "effect": {"type": "string", "minLength": 5},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "kind", "binding_id", "resource_claims"],
        "properties": {
          "node_id": {"type": "string"},
          "kind": {"enum": ["capability", "external_system", "human_action"]},
          "binding_id": {"type": "string"},
          "resource_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "mapping"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"enum": ["control", "data", "condition"]},
          "mapping": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "hold_conditions": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failure_policy": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["draft", "reviewed", "verified", "deprecated"]}
  },
  "additionalProperties": false
}
