{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/solution-artifact.schema.json",
  "title": "Compiled Robot Scenario Solution Artifact",
  "type": "object",
  "required": [
    "solution_id",
    "scenario_id",
    "assessment_id",
    "output_mode",
    "task_nodes",
    "task_edges",
    "behavior_tree_xml",
    "tests",
    "unresolved_errors",
    "release_decision"
  ],
  "properties": {
    "solution_id": {"type": "string", "pattern": "^SOL-[A-Z0-9-]+$"},
    "scenario_id": {"type": "string", "pattern": "^SCN-[A-Z0-9-]+$"},
    "assessment_id": {"type": "string", "pattern": "^ASM-[A-Z0-9-]+$"},
    "output_mode": {"enum": ["solution", "prototype_plan", "evidence_plan", "rejection"]},
    "task_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "binding_type", "binding_id", "requirement_ids"],
        "properties": {
          "node_id": {"type": "string"},
          "binding_type": {"enum": ["capability", "composition", "external_system", "human_action", "condition"]},
          "binding_id": {"type": "string"},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "task_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"enum": ["sequence", "fallback", "parallel", "data", "guard"]}
        },
        "additionalProperties": false
      }
    },
    "behavior_tree_xml": {"type": ["string", "null"]},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "requirement_ids", "criterion_refs", "level", "procedure", "expected_result"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^TEST-[A-Z0-9-]+$"},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"}, "uniqueItems": true},
          "criterion_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "level": {"enum": ["structural", "contract", "simulation", "bench", "pilot", "field"]},
          "procedure": {"type": "string"},
          "expected_result": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unresolved_errors": {"type": "array", "items": {"type": "string"}},
    "release_decision": {"enum": ["release", "conditional_release", "hold", "reject"]}
  },
  "additionalProperties": false
}
