{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/atomic-capability.schema.json",
  "title": "Robot Atomic Capability",
  "type": "object",
  "required": [
    "capability_id",
    "semantic_key",
    "name",
    "capability_type",
    "verification_profiles",
    "migration_warnings",
    "effect",
    "scope",
    "inputs",
    "outputs",
    "preconditions",
    "hold_conditions",
    "postconditions",
    "constraints",
    "quality_metrics",
    "measurements",
    "failure_modes",
    "recovery_behavior",
    "incompatible_resources",
    "interface",
    "evidence",
    "confidence",
    "dependencies",
    "unknowns",
    "status"
  ],
  "properties": {
    "capability_id": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" },
    "semantic_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "description": "与厂商和机型无关的语义归一键，用于需求匹配和跨实现去重"
    },
    "name": { "type": "string", "minLength": 3 },
    "capability_type": {
      "enum": ["building_block", "operational_behavior"],
      "description": "A callable engineering primitive or an independently testable end-to-end behavior"
    },
    "legacy_abstraction_level": {"type": ["string", "null"]},
    "verification_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/verification_profile"}
    },
    "migration_warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effect": { "type": "string", "minLength": 5 },
    "scope": {
      "type": "object",
      "required": ["platform_claims", "body_parts", "selector"],
      "properties": {
        "platform_claims": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "保留来源中的原始机型称谓；完成实体归一前不得擅自合并"
        },
        "body_parts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "selector": { "type": "string", "description": "能力作用对象的选择方式，如 MotorName" },
        "resolution_status": { "enum": ["resolved", "ambiguous", "conflicted"] }
      },
      "additionalProperties": false
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "hold_conditions": { "type": "array", "items": { "type": "string" } },
    "postconditions": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "object",
      "required": ["time", "space", "information", "energy"],
      "properties": {
        "time": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "space": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "information": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "energy": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
      },
      "additionalProperties": false
    },
    "quality_metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measurement_id", "metric", "test_level", "conditions", "sample_size", "passed_count", "value", "unit", "evidence_locator"],
        "properties": {
          "measurement_id": { "type": "string", "pattern": "^MEAS-[A-Z0-9-]+$" },
          "metric": { "type": "string" },
          "test_level": { "enum": ["simulation", "bench", "pilot", "field"] },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "sample_size": { "type": "integer", "minimum": 1 },
          "passed_count": { "type": "integer", "minimum": 0 },
          "value": {},
          "unit": { "type": ["string", "null"] },
          "evidence_locator": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "failure_modes": { "type": "array", "items": { "type": "string" } },
    "recovery_behavior": { "type": "array", "items": { "type": "string" } },
    "incompatible_resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "interface": {
      "type": "object",
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["sdk", "api", "ros_topic", "ros_service", "ros_action", "cli", "tool", "manual", "other"] },
        "reference": { "type": "string" },
        "version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["wiki_entry", "locator"],
        "properties": {
          "wiki_entry": { "type": "string" },
          "locator": { "type": "string" },
          "source_version": { "type": ["string", "null"] },
          "excerpt": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "object",
      "required": ["score", "basis"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" }, "uniqueItems": true },
    "unknowns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "enum": ["draft", "reviewed", "verified", "deprecated"] }
  },
  "$defs": {
    "verification_profile": {
      "type": "object",
      "required": ["workspace_type", "lighting", "terrain_weather", "workspace_dynamics", "object_payload_boundary", "duty_cycle", "versions", "test_level", "sample_size", "passed_count", "measured_values", "evidence_locator", "support_state", "limitations", "unknowns"],
      "properties": {
        "workspace_type": {"type": "string"}, "lighting": {"type": "string"}, "terrain_weather": {"type": "string"}, "workspace_dynamics": {"type": "string"},
        "object_payload_boundary": {"type": "string"}, "duty_cycle": {"type": "string"}, "versions": {"type": "object"},
        "test_level": {"enum": ["simulation", "bench", "pilot", "field"]}, "sample_size": {"type": "integer", "minimum": 0}, "passed_count": {"type": "integer", "minimum": 0},
        "measured_values": {"type": "array", "items": {"type": "object"}}, "evidence_locator": {"type": "string"},
        "support_state": {"enum": ["supported", "conditional", "unproven", "not_supported"]}, "limitations": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["name", "data_type"],
      "properties": {
        "name": { "type": "string" },
        "data_type": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "frame": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["name", "operator", "value", "known"],
      "properties": {
        "name": { "type": "string" },
        "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "contains", "compatible_with", "unknown"] },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "known": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["name", "value", "operator"],
      "properties": {
        "name": { "type": "string" },
        "value": {},
        "operator": { "enum": ["eq", "lt", "lte", "gt", "gte", "range", "unknown"] },
        "unit": { "type": ["string", "null"] },
        "test_method": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
