{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/atomic-requirement.schema.json",
  "title": "Robot Scenario Atomic Requirement",
  "type": "object",
  "required": [
    "requirement_id",
    "name",
    "required_abstraction_level",
    "source_statements",
    "subject",
    "trigger",
    "preconditions",
    "effect",
    "inputs",
    "outputs",
    "acceptance_criteria",
    "constraints",
    "primary_constraint_dimensions",
    "derived_constraint_ids",
    "priority",
    "criticality",
    "dependencies",
    "logic_group",
    "unknowns",
    "assumptions",
    "exclusions",
    "status"
  ],
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 3},
    "required_abstraction_level": {
      "enum": ["L1_atomic_skill", "L2_composite_skill", "L3_scenario_module"]
    },
    "source_statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "source", "state"],
        "properties": {
          "text": {"type": "string"},
          "source": {"type": "string"},
          "state": {"enum": ["known", "assumed", "unknown"]}
        },
        "additionalProperties": false
      }
    },
    "subject": {"type": "string"},
    "trigger": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "effect": {
      "type": "object",
      "required": ["verb", "object", "target_state"],
      "properties": {
        "verb": {"type": "string"},
        "object": {"type": "string"},
        "target_state": {"type": "string"}
      },
      "additionalProperties": false
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/semantic_port"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/semantic_port"}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "constraints": {
      "type": "object",
      "required": ["time", "space", "information", "energy"],
      "properties": {
        "time": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "space": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "information": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "energy": {"type": "array", "items": {"$ref": "#/$defs/criterion"}}
      },
      "additionalProperties": false
    },
    "primary_constraint_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["time", "space", "information", "energy", "safety", "regulatory"]},
      "uniqueItems": true
    },
    "derived_constraint_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CD-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "priority": {"enum": ["must", "should", "could", "wont"]},
    "criticality": {"enum": ["normal", "mission_critical", "safety_critical", "regulatory_critical"]},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"}, "uniqueItems": true},
    "logic_group": {
      "type": "object",
      "required": ["operator", "group_id"],
      "properties": {
        "operator": {"enum": ["and", "or", "optional", "standalone"]},
        "group_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "blocking", "reason"],
        "properties": {
          "question": {"type": "string"},
          "blocking": {"type": "boolean"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "confirmed", "frozen", "deprecated"]}
  },
  "$defs": {
    "semantic_port": {
      "type": "object",
      "required": ["name", "semantic_type"],
      "properties": {
        "name": {"type": "string"},
        "semantic_type": {"type": "string"},
        "description": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["metric", "operator", "value", "unit", "hard", "state", "test_method"],
      "properties": {
        "metric": {"type": "string"},
        "operator": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "range", "contains", "compatible_with", "unknown"]},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "hard": {"type": "boolean"},
        "state": {"enum": ["known", "assumed", "unknown"]},
        "test_method": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
