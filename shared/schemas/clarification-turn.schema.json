{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/clarification-turn.schema.json",
  "title": "Scenario Clarification Turn",
  "type": "object",
  "required": ["state_patch", "candidate_questions", "candidate_issues", "intent", "model_readiness_opinion"],
  "properties": {
    "state_patch": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/state_patch"}},
    "candidate_questions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/question"}},
    "candidate_issues": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "intent": {"enum": ["requirement_answer", "report_question", "requirement_change", "new_scenario", "unclear"]},
    "model_readiness_opinion": {"type": "object", "required": ["stable", "reason"], "properties": {"stable": {"type": "boolean"}, "reason": {"type": "string"}}, "additionalProperties": false}
  },
  "$defs": {
    "state_patch": {
      "oneOf": [
        {"type": "object", "required": ["op", "path", "value"], "properties": {"op": {"const": "set"}, "path": {"const": "workflow.steps"}, "value": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 500}}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "path", "value"], "properties": {"op": {"const": "set"}, "path": {"enum": ["goal.confirmation", "workflow.confirmation", "allowed_modifications.confirmation", "human_intervention.confirmation"]}, "value": {"enum": ["unknown", "proposed", "confirmed", "conflicted"]}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "path", "value"], "properties": {"op": {"const": "set"}, "path": {"enum": ["goal.original_text", "goal.normalized_value", "workflow.trigger", "workflow.end_outcome"]}, "value": {"type": "string", "minLength": 1, "maxLength": 5000}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "path", "value"], "properties": {"op": {"const": "set"}, "path": {"type": "string", "pattern": "^((environment|operating_profile)\\.[A-Za-z0-9_]+|(allowed_modifications|human_intervention)\\.(?!confirmation$)[A-Za-z0-9_]+)$"}, "value": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 5000}, {"type": "number"}, {"type": "boolean"}, {"$ref": "#/$defs/numeric_envelope"}]}}, "additionalProperties": false},
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "properties": {"op": {"enum": ["append", "upsert"]}, "path": {"enum": ["actors", "objects", "acceptance_criteria", "facts", "assumptions", "requirements", "unresolved_issues"]}, "value": {"$ref": "#/$defs/patch_record"}},
          "allOf": [
            {"if": {"properties": {"path": {"const": "actors"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "actor_id", "name", "role", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "last_changed_version"]}, "anyOf": [{"required": ["semantic_key"]}, {"required": ["actor_id"]}]}}}},
            {"if": {"properties": {"path": {"const": "objects"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "object_id", "name", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "last_changed_version"]}, "anyOf": [{"required": ["semantic_key"]}, {"required": ["object_id"]}]}}}},
            {"if": {"properties": {"path": {"const": "acceptance_criteria"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "criterion_id", "name", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "last_changed_version"]}, "anyOf": [{"required": ["semantic_key"]}, {"required": ["criterion_id"]}]}}}},
            {"if": {"properties": {"path": {"const": "facts"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "affected_decision", "can_change_conclusion", "last_changed_version"]}, "required": ["semantic_key"]}}}},
            {"if": {"properties": {"path": {"const": "assumptions"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "affected_decision", "can_change_conclusion", "last_changed_version"]}, "required": ["semantic_key"]}}}},
            {"if": {"properties": {"path": {"const": "requirements"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "requirement_id", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "affected_decision", "can_change_conclusion", "last_changed_version"]}, "anyOf": [{"required": ["semantic_key"]}, {"required": ["requirement_id"]}]}}}},
            {"if": {"properties": {"path": {"const": "unresolved_issues"}}}, "then": {"properties": {"value": {"propertyNames": {"enum": ["semantic_key", "issue_id", "original_text", "normalized_value", "knowledge_state", "owner", "evidence_locator", "affected_decision", "can_change_conclusion", "next_action", "status", "last_changed_version", "resolution_options"]}, "anyOf": [{"required": ["semantic_key"]}, {"required": ["issue_id"]}]}}}}
          ],
          "additionalProperties": false
        }
      ]
    },
    "numeric_envelope": {
      "type": "object", "required": ["unit"],
      "properties": {"value": {"type": "number"}, "min": {"type": "number"}, "max": {"type": "number"}, "unit": {"type": "string", "minLength": 1, "maxLength": 40}},
      "anyOf": [{"required": ["value"]}, {"required": ["min"]}, {"required": ["max"]}],
      "additionalProperties": false
    },
    "patch_record": {
      "type": "object",
      "properties": {
        "semantic_key": {"type": "string", "minLength": 1}, "requirement_id": {"type": "string", "minLength": 1}, "issue_id": {"type": "string", "minLength": 1}, "actor_id": {"type": "string", "minLength": 1}, "object_id": {"type": "string", "minLength": 1}, "criterion_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "maxLength": 5000}, "role": {"type": "string", "maxLength": 5000}, "original_text": {"type": "string", "maxLength": 5000}, "normalized_value": {"anyOf": [{"type": "string", "maxLength": 5000}, {"type": "number"}, {"type": "boolean"}, {"$ref": "#/$defs/numeric_envelope"}, {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 500}}]},
        "knowledge_state": {"enum": ["known", "assumed", "unknown", "conflicted"]}, "owner": {"enum": ["customer", "wiki", "vendor", "calculation", "simulation", "bench", "pilot", "field"]}, "evidence_locator": {"type": ["string", "null"], "maxLength": 1000}, "affected_decision": {"type": "string", "maxLength": 5000}, "can_change_conclusion": {"type": "boolean"}, "next_action": {"type": "string", "maxLength": 5000}, "status": {"type": "string", "maxLength": 5000}, "last_changed_version": {"type": "integer", "minimum": 1}, "resolution_options": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      },
      "anyOf": [{"required": ["semantic_key"]}, {"required": ["requirement_id"]}, {"required": ["issue_id"]}, {"required": ["actor_id"]}, {"required": ["object_id"]}, {"required": ["criterion_id"]}],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["question_id", "semantic_key", "question", "reason_for_asking", "decision_impact", "can_change_conclusion", "blocking", "target_owner", "answer_type", "options", "prerequisite_keys"],
      "properties": {
        "question_id": {"type": "string"}, "semantic_key": {"type": "string"}, "question": {"type": "string"}, "reason_for_asking": {"type": "string"},
        "decision_impact": {"type": "array", "items": {"enum": ["safety", "feasibility", "architecture", "cost", "acceptance"]}},
        "can_change_conclusion": {"type": "boolean"}, "blocking": {"type": "boolean"},
        "target_owner": {"enum": ["customer", "wiki", "vendor", "calculation", "simulation", "bench", "pilot", "field"]},
        "answer_type": {"const": "single_select_or_custom"}, "options": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "prerequisite_keys": {"type": "array", "items": {"type": "string"}}, "refines_question_id": {"type": ["string", "null"]},
        "previous_answer": {"type": ["string", "null"]}, "missing_precision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
