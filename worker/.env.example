SERVER_URL=ws://120.77.250.227:8000/ws/client
WORKER_SHARED_SECRET=replace-with-the-same-secret-as-ecs
# Bootstrap robot IDs only. Robots added in the admin UI are stored by ECS and
# synchronized from raw/sources; this list does not need editing for each one.
ALLOWED_TEAMS=tian_gong,walker_s2,walker_c1

# This must be the exact LLM Wiki project path selected in the GUI.
# Replace <username> with the new Worker's real Linux username. Use absolute
# paths; do not leave a literal $HOME here because dotenv does not expand it.
BASE_DIR=/home/<username>/Documents/agent_7_14/agent1/agent
STAGING_DIR=/home/<username>/Documents/agent_7_14/agent1/agent/.agent1-worker/staging
TRASH_DIR=/home/<username>/Documents/agent_7_14/agent1/agent/.agent1-trash

QA_WORKERS=3
DOWNLOAD_WORKERS=2
FILE_OPERATION_WORKERS=1
FILE_MANAGER_MAX_ENTRIES=10000
# Public QA and maintenance workflows use DeepSeek.
# Keep this key only on the Worker.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MERGE_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=240
DEEPSEEK_SECTION_MAX_TOKENS=8192
DEEPSEEK_STRUCTURED_RETRIES=1
DEEPSEEK_TRANSPORT_RETRIES=1
# Maximum selected + related generated Wiki pages supplied to one answer.
WIKI_QA_MAX_PAGES=8
WIKI_QA_MAX_PAGE_CHARS=24000
# Bounded plan -> FTS5 -> related-page -> evidence -> streamed-answer path.
QA_REASONING_MAX_CANDIDATES=15
QA_REASONING_MAX_PAGES=6
QA_STRICT_ROBOT_SCOPE=true
DOWNLOAD_TIMEOUT=1800
MAX_UPLOAD_BYTES=5368709120
MAX_ZIP_FILES=20000
MAX_ZIP_EXTRACTED_BYTES=10737418240
MAX_ZIP_SINGLE_FILE_BYTES=2147483648

LLM_WIKI_QUEUE_FILE=/home/<username>/Documents/agent_7_14/agent1/agent/.llm-wiki/ingest-queue.json
LLM_WIKI_CACHE_FILE=/home/<username>/Documents/agent_7_14/agent1/agent/.llm-wiki/ingest-cache.json
LLM_WIKI_POLL_SECONDS=2
# Heartbeat/resend interval only. Active LLM Wiki work is not failed when this elapses.
LLM_WIKI_MONITOR_TIMEOUT=7200

# Keep false while Source Watch + Auto Ingest are enabled, otherwise the same
# source can be detected both by the watcher and by an explicit API rescan.
LLM_WIKI_RESCAN_AFTER_PUBLISH=false

# Optional. The Worker does not need the API for normal auto-watch ingestion.
LLM_WIKI_API_URL=http://127.0.0.1:19828/api/v1
LLM_WIKI_API_TOKEN=
LLM_WIKI_PROJECT_ID=

# Anonymous browser conversations keep a small in-memory history. A given
# conversation ID is always routed to the same QA lane.
CONVERSATION_MAX_TURNS=6
CONVERSATION_MAX_SESSIONS=1000

# Prompt-injection guard and non-blocking text-source scan limits.
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_TIMEOUT=20
PROMPT_GUARD_CONCURRENCY=2
PROMPT_SCAN_MAX_FILE_BYTES=2097152
PROMPT_SCAN_MAX_TOTAL_BYTES=10485760
PROMPT_SCAN_MAX_WARNINGS=1000
