SERVER_URL=ws://47.239.12.206:8000/ws/client
WORKER_SHARED_SECRET=replace-with-the-same-secret-as-ecs

# This must be the exact LLM Wiki project path selected in the GUI.
BASE_DIR=/home/eason/Documents/agent_7_14/agent1/agent
STAGING_DIR=/home/eason/Documents/agent_7_14/agent1/agent/.agent1-worker/staging
TRASH_DIR=/home/eason/Documents/agent_7_14/agent1/agent/.agent1-trash

QA_WORKERS=3
DOWNLOAD_WORKERS=2
FILE_OPERATION_WORKERS=1
FILE_MANAGER_MAX_ENTRIES=10000
CLAUDE_TIMEOUT=240
DOWNLOAD_TIMEOUT=1800
MAX_UPLOAD_BYTES=5368709120
MAX_ZIP_FILES=20000
MAX_ZIP_EXTRACTED_BYTES=10737418240
MAX_ZIP_SINGLE_FILE_BYTES=2147483648

LLM_WIKI_QUEUE_FILE=/home/eason/Documents/agent_7_14/agent1/agent/.llm-wiki/ingest-queue.json
LLM_WIKI_CACHE_FILE=/home/eason/Documents/agent_7_14/agent1/agent/.llm-wiki/ingest-cache.json
LLM_WIKI_POLL_SECONDS=2
LLM_WIKI_MONITOR_TIMEOUT=7200

# Keep false while Source Watch + Auto Ingest are enabled, otherwise the same
# source can be detected both by the watcher and by an explicit API rescan.
LLM_WIKI_RESCAN_AFTER_PUBLISH=false

# Optional. The Worker does not need the API for normal auto-watch ingestion.
LLM_WIKI_API_URL=http://127.0.0.1:19828/api/v1
LLM_WIKI_API_TOKEN=
LLM_WIKI_PROJECT_ID=

# Read-only Claude tools are pre-approved so the service never asks the web
# user to approve reading CLAUDE.md or wiki files.
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep
CLAUDE_EXTRA_ARGS=

# Anonymous browser conversations keep a small in-memory history. A given
# conversation ID is always routed to the same QA lane.
CONVERSATION_MAX_TURNS=6
CONVERSATION_MAX_SESSIONS=1000
